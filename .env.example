# Settings for jira-data. Use letters, digits, hyphens and underscores only.
# scripts/init-env.sh copies this file to .env with new passwords.

# Database owner, used by the loader. Only applied when the database is first created.
POSTGRES_DB=jsm
POSTGRES_USER=jira_owner
POSTGRES_PASSWORD=change-me-owner

# Read-only user for pgAdmin and desktop SQL tools
ANALYST_USER=jira_reader
ANALYST_PASSWORD=change-me-reader

# pgAdmin requires these, but opens without a login
PGADMIN_EMAIL=pgadmin4@pgadmin.org
PGADMIN_PASSWORD=change-me-pgadmin

# Metabase login. Only applied when Metabase first starts.
METABASE_EMAIL=admin@jira-data.local
METABASE_PASSWORD=change-me-metabase-1

# Ports on this computer
DB_PORT=5433
PGADMIN_PORT=5050
FILES_PORT=8080
METABASE_PORT=3000
